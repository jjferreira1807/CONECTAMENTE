# =============================================================
# Supabase — required for auth, sync, and remote storage.
# Without these, the app runs fully on localStorage (no sign-up).
# =============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================
# Server-only. Used for GDPR account deletion and admin tasks.
# NEVER expose this to the browser.
# =============================================================
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================
# Optional: deployment URL (for OAuth redirects in production).
# =============================================================
NEXT_PUBLIC_SITE_URL=https://conectamente.pt
